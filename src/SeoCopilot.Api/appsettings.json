{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=seocopilot;Username=seocopilot;Password=seocopilot"
  },
  "Jwt": {
    "Issuer": "seocopilot",
    "Audience": "seocopilot",
    "Key": "CHANGE-ME-super-secret-signing-key-at-least-32-bytes",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Crawler": {
    "UserAgent": "SeoCopilotBot/1.0 (+https://seocopilot.local/bot)",
    "UserAgentToken": "seocopilotbot",
    "RequestTimeoutSeconds": 30,
    "MaxRedirects": 5,
    "MaxHtmlBytes": 5242880,
    "MaxMainTextChars": 200000,
    "MaxImageChecksPerPage": 10
  },
  "Anthropic": {
    "ApiKey": "",
    "Model": "claude-sonnet-5",
    "MaxTokens": 4096,
    "WorkspaceId": ""
  },
  "CloudflareAi": {
    "AccountId": "",
    "ApiToken": "",
    "BaseUrl": "https://api.cloudflare.com/client/v4",
    "Model": "@cf/black-forest-labs/flux-2-klein-4b",
    "TimeoutSeconds": 60,
    "MaxFlaggedRetries": 2
  },
  "Reports": {
    "Directory": "App_Data/reports"
  },
  "Assets": {
    "Directory": "App_Data/assets"
  },
  "SocialImages": {
    "Sources": [ "site", "card" ],
    "Templates": [],
    "MaxAiImagesPerDay": 20
  },
  "SiteImages": {
    "MaxBytes": 8388608,
    "TimeoutSeconds": 15,
    "AllowPrivateNetworks": false
  },
  "ImageOverlay": {
    "Enabled": true,
    "Quality": 90,
    "MarginRatio": 0.06,
    "HeadlineSizeRatio": 0.078,
    "BrandSizeRatio": 0.032,
    "MaxHeadlineLines": 3
  },
  "PageSpeed": {
    "ApiKey": ""
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "User": "",
    "Password": "",
    "FromAddress": "no-reply@seocopilot.local",
    "FromName": "SeoCopilot"
  }
}
