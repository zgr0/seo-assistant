# Tek giris noktasi: statik SPA + /api ters vekil.
# vite.config.ts'teki dev proxy'nin prod karsiligi — iki ortamda da uygulama
# ayni koken uzerinden /api cagirir, CORS gerekmez.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8080
	}

	# Hangfire panosu bilerek disari acilmaz; gerekirse `docker compose exec` ile
	# ya da api servisine gecici port yayinlayarak erisin.

	handle {
		root * /srv
		# SPA: bilinmeyen yol index.html'e duser, yonlendirmeyi router yapar.
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Vite hash'li varliklari /assets altina yazar (ör. index-p3aBx3Cq.js) — degismez, uzun sureli
	# onbelleklenir. Geri kalan her sey, ozellikle "/" ve SPA'nin try_files ile dondugu index.html,
	# her istekte yeniden dogrulanir: aksi halde tarayici eski index.html'i tutup yeni surumu hic
	# yuklemez. (Eski kural yalniz "/index.html" yolunu yakaliyordu; tarayici ise "/" ister.)
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@notHashed not path /assets/*
	header @notHashed Cache-Control "no-cache"
}
