# Tek giris noktasi: statik SPA + /api ters vekil.
# vite.config.ts'teki dev proxy'nin prod karsiligi — iki ortamda da uygulama
# ayni koken uzerinden /api cagirir, CORS gerekmez.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8080
	}

	# Hangfire panosu bilerek disari acilmaz; gerekirse `docker compose exec` ile
	# ya da api servisine gecici port yayinlayarak erisin.

	handle {
		root * /srv
		# SPA: bilinmeyen yol index.html'e duser, yonlendirmeyi router yapar.
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Hash'li varliklar uzun sureli onbelleklenebilir; index.html asla.
	@hashed path_regexp \.[0-9a-f]{8,}\.(js|css|woff2?|png|jpg|svg|webp|avif)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
}
