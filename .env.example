# .env.example — kopyalayip `.env` yapin, degerleri doldurun.
# `.env` git'e girmez (.gitignore).

# --- Veritabani ---
POSTGRES_DB=seocopilot
POSTGRES_USER=seocopilot
# ZORUNLU. Kendi degerinizi uretin, asagidakini oldugu gibi kullanmayin.
POSTGRES_PASSWORD=

# --- JWT imzalama anahtari ---
# ZORUNLU, en az 32 bayt. Kisa olursa API acilista hata verip durur.
# Uretmek icin:
#   openssl rand -base64 48
#   pwsh: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_KEY=
JWT_ISSUER=seocopilot
JWT_AUDIENCE=seocopilot

# --- Istege bagli servisler (bos birakilirsa ilgili ozellik sessizce atlanir) ---
# Icerik uretimi icin Anthropic anahtari
ANTHROPIC_API_KEY=
# Anahtar bir workspace'e bagli degilse (organizasyon anahtari) zorunlu.
# Konsolda workspace URL'indeki kimlik: /workspaces/<id>
ANTHROPIC_WORKSPACE_ID=
# Core Web Vitals olcumu icin PageSpeed Insights anahtari
PAGESPEED_API_KEY=
# Sosyal medya gorseli icin Cloudflare Workers AI (FLUX.2 klein). Bos birakilirsa
# "Yapay zeka ile uret" dugmesi gizlenir; gorseller site fotografi / marka kartindan gelir.
# Hesap kimligi: dash.cloudflare.com > Workers AI > "Use REST API".
# Token: My Profile > API Tokens > Create Token, izin: Account > Workers AI > Read + Edit.
# Gunluk 10.000 neuron ucretsiz (~90 gorsel, hesap geneli); asimi icin Workers Paid gerekir.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Kiraci basina gunluk yapay zeka gorseli siniri (varsayilan 20).
AI_IMAGES_PER_DAY=20

# --- Portlar ---
# Uygulamanin yayinlandigi port (Caddy).
WEB_PORT=8080
# compose.yaml icinde varsayilan olarak kapali olan portlar:
# API_PORT=5094
# DB_PORT=55432
